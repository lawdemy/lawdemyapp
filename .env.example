# Public site address (used for SEO, sitemap and Paystack callback)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.ng

# Paystack (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Contact form email delivery via Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_TO=admissions@your-domain.ng
CONTACT_FROM=Lawdemy Website <website@your-domain.ng>

# Supabase (https://supabase.com/dashboard/project/_/settings/api) — student login and courses
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxx
# Service role key: server-only, never exposed to the browser. Used only by the Paystack webhook.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxx
